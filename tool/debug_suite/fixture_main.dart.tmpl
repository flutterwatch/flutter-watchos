// The debug suite's fixture app. run.sh copies this file over lib/main.dart
// of a freshly created app. It prints one marker per kind of log line, keeps
// a timer running for the breakpoint check and animates for the timeline.

import 'dart:async';
import 'dart:io';

import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';

/// Counts timer ticks; vmcheck reads it in a paused frame.
int beats = 0;

/// Set by vmcheck through evaluate; a hot restart puts it back.
String marker = 'unset';

/// Gives vmcheck something to allocate.
List<int> allocate(int n) => List<int>.filled(n, 7);

/// One timer tick. vmcheck sets its breakpoint on the marked line.
void tick() {
  beats++; // SUITE_BREAKPOINT
}

/// Prints the log markers once, then starts the timers and the app.
void main() {
  print('SUITE_MARK_PRINT');
  debugPrint('SUITE_MARK_DEBUGPRINT');
  debugPrint('SUITE_MARK_MULTI_1\nSUITE_MARK_MULTI_2');
  print('SUITE_MARK_QUOTE "quoted" end');
  stdout.writeln('SUITE_MARK_STDOUT');
  stderr.writeln('SUITE_MARK_STDERR');
  FlutterError.reportError(
    FlutterErrorDetails(exception: Exception('SUITE_MARK_FLUTTER_ERROR')),
  );
  Timer(
    const Duration(seconds: 1),
    () => throw StateError('SUITE_MARK_UNHANDLED'),
  );
  Timer.periodic(const Duration(milliseconds: 250), (_) => tick());
  runApp(const FixtureApp());
}

/// A screen with a label and a spinner, so frames keep coming.
class FixtureApp extends StatelessWidget {
  /// Creates the fixture app.
  const FixtureApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      home: Scaffold(
        body: Center(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: <Widget>[
              Text('SUITE_TEXT_A'),
              CircularProgressIndicator(),
            ],
          ),
        ),
      ),
    );
  }
}
